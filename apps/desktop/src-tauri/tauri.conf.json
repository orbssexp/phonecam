{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoneCam",
  "version": "0.2.0",
  "identifier": "dev.orbssexp.phonecam",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhoneCam",
        "width": 1000,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "vendor/*.dll": "./",
      "vendor/win32/softcam.dll": "softcam32/softcam.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NEIyQkFEOEQ5REZBM0MKUldROCtwMk5yU3RMbFZRUTRqYmVUYXRpRjNlRVlHU3JyV3JhQ1c4d2F3bHpqcUVEN3JpUjJ0d0oK",
      "endpoints": ["https://github.com/orbssexp/phonecam/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}

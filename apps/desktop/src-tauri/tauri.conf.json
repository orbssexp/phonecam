{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhoneCam",
  "version": "0.2.0",
  "identifier": "dev.orbssexp.phonecam",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PhoneCam",
        "width": 1000,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "vendor/*.dll": "./",
      "vendor/win32/softcam.dll": "softcam32/softcam.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
